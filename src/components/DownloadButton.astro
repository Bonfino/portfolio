---
interface Props {
  href: string;
  label?: string;
}

const { href, label = "View Resume" } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center gap-2 border border-indigo-400 bg-indigo-500/10 text-indigo-300 font-medium px-4 py-2 rounded-lg hover:bg-indigo-500 hover:text-white hover:border-indigo-400 transition-all duration-200 shadow-[0_0_12px_rgba(99,102,241,0.15)] hover:shadow-[0_0_16px_rgba(99,102,241,0.35)]"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="lucide lucide-download"
    aria-hidden="true"
  >
    <path d="M12 15V3"></path>
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
    <path d="m7 10 5 5 5-5"></path>
  </svg>
  {label}
</a>
