---

---

<section id="certifications" class="py-16 px-4 container mx-auto">
  <div class="flex flex-col md:flex-row gap-10">
    <!-- Certifications -->
    <div class="flex flex-col gap-6 w-full md:flex-[1.5]">
      <h3 class="text-sm font-medium tracking-widest uppercase text-[#8c8c8c]">
        Certifications
      </h3>

      <div class="flex flex-col gap-3">
        <div
          class="flex flex-col gap-1 border border-[#2a2a2a] bg-[#121212] rounded-lg px-4 py-3"
        >
          <div
            class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4"
          >
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-base text-[#F8F8F8] font-medium break-words">
                Docker Foundations Professional Certificate
              </span>

              <span class="text-sm text-[#8c8c8c] font-light italic">
                Docker, Inc
              </span>
            </div>

            <span
              class="text-sm text-[#8c8c8c] font-light tabular-nums shrink-0"
            >
              2026
            </span>
          </div>
        </div>

        <div
          class="flex flex-col gap-1 border border-[#2a2a2a] bg-[#121212] rounded-lg px-4 py-3"
        >
          <div
            class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4"
          >
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-base text-[#F8F8F8] font-medium break-words">
                First Certificate in English (FCE)
              </span>

              <span class="text-sm text-[#8c8c8c] font-light italic">
                Cambridge University Press & Assessment
              </span>
            </div>

            <span
              class="text-sm text-[#8c8c8c] font-light tabular-nums shrink-0"
            >
              2022
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Languages -->
    <div class="flex flex-col gap-6 w-full md:flex-1">
      <h3 class="text-sm font-medium tracking-widest uppercase text-[#8c8c8c]">
        Languages
      </h3>

      <div class="flex flex-col gap-3">
        <div
          class="flex items-center justify-between gap-4 border border-[#2a2a2a] bg-[#121212] rounded-lg px-4 py-3"
        >
          <span class="text-base text-[#F8F8F8] font-medium"> Italian </span>

          <span class="text-sm text-[#8c8c8c] font-light"> Native </span>
        </div>

        <div
          class="flex items-center justify-between gap-4 border border-[#2a2a2a] bg-[#121212] rounded-lg px-4 py-3"
        >
          <span class="text-base text-[#F8F8F8] font-medium"> English </span>

          <span class="text-sm text-[#8c8c8c] font-light"> B2 </span>
        </div>
      </div>
    </div>
  </div>
</section>
