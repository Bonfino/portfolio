---
const projects = [
  {
    title: "TST Media Management",
    subtitle: "WordPress Plugin",
    tags: ["PHP", "JavaScript", "SQL", "AJAX", "WP-CLI"],
    descriptions: [
      'Engineered a <span class="text-[#F8F8F8]">WordPress media-management plugin</span> for sites containing <span class="text-[#F8F8F8]">8,000+ images</span>, detecting and safely managing unused assets across <span class="text-[#F8F8F8]">ACF, WooCommerce, Gutenberg, and Polylang</span> content.',
      'Designed a <span class="text-[#F8F8F8]">four-stage batch-scanning</span> architecture for shared-hosting environments, including recursive analysis of serialized data structures.',
      'Implemented a <span class="text-[#F8F8F8]">virtual-folder workflow</span>, reversible trash system, and <span class="text-[#F8F8F8]">WP-CLI ZIP export</span> to support safer cleanup and recovery.'
    ]
  },
];
---

<section id="projects" class="container mx-auto py-16 px-4">
  <div class="flex flex-col gap-10">
    <h2 class="text-2xl font-medium tracking-widest uppercase text-white">
      Projects
    </h2>

    <div class="flex flex-col gap-10">
      {projects.map((project) => (
        <div class="flex flex-col gap-3">
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <div class="flex items-baseline gap-2 flex-wrap">
              <span class="text-xl text-[#F8F8F8] font-medium">{project.title}</span>
              {project.subtitle && (
                <span class="text-sm text-[#8c8c8c] font-light italic">— {project.subtitle}</span>
              )}
            </div>
            <div class="flex gap-2 flex-wrap justify-end">
              {project.tags.map((tag) => (
                <span class="text-xs text-[#8c8c8c] font-light border border-[#2a2a2a] bg-[#121212] rounded-full px-2.5 py-0.5">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            {project.descriptions.map((desc) => (
              <p 
                class="text-lg font-light text-[#8c8c8c] leading-relaxed pl-3 border-l border-[#2a2a2a]"
                set:html={desc}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>