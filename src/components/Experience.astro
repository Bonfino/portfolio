---

---

<section id="experience" class="py-16 px-4 container mx-auto">
  <div class="flex flex-col gap-10">
    <div>
      <h2 class="text-2xl font-medium tracking-widest uppercase text-white">
        Experience
      </h2>

      <div class="flex items-center gap-6 mt-2">
        <button
          data-tab="work"
          class="tab-btn text-base font-light tracking-wide pb-0.5 transition-colors duration-200
         text-[#F8F8F8] border-b border-[#F8F8F8] cursor-pointer hover:text-[#F8F8F8]"
        >
          Work
        </button>
        <button
          data-tab="education"
          class="tab-btn text-base font-light tracking-wide pb-0.5 transition-colors duration-200
         text-[#8c8c8c] border-b border-transparent cursor-pointer hover:text-[#F8F8F8]"
        >
          Education
        </button>
      </div>
    </div>

    <div class="grid">
      <div id="tab-work" class="[grid-area:1/1] flex flex-col gap-10">
        <div class="flex flex-col gap-2">
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-xl text-[#F8F8F8] font-medium">TWOW</span>
            <span class="text-sm text-[#8c8c8c] font-light tabular-nums"
              >Nov 2025 – Present</span
            >
          </div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-base text-[#8c8c8c] font-light italic"
              >Junior Full Stack Developer</span
            >
            <span class="text-sm text-[#8c8c8c] font-light"
              >On-site Internship · Genoa, Italy</span
            >
          </div>
          <div class="flex flex-col gap-1.5 mt-1">
            <p class="text-lg font-light text-[#8c8c8c] leading-relaxed pl-3 border-l border-[#2a2a2a]">
              Develop and maintain full-stack web applications using <span class="text-[#F8F8F8]">PHP</span>, <span class="text-[#F8F8F8]">JavaScript</span>, and <span class="text-[#F8F8F8]">SQL</span>, collaborating through Git-based workflows and contributing to custom WordPress implementations.
            </p>
            <p class="text-lg font-light text-[#8c8c8c] leading-relaxed pl-3 border-l border-[#2a2a2a]">
              Build and optimize <span class="text-[#F8F8F8]">Laravel</span> middleware and <span class="text-[#F8F8F8]">REST API</span> integrations supporting client-server data exchange and application functionality.
            </p>
            <p class="text-lg font-light text-[#8c8c8c] leading-relaxed pl-3 border-l border-[#2a2a2a]">
              Refactor codebases and resolve defects across 10+ high-traffic client platforms, reducing accessibility errors by <span class="text-[#F8F8F8]">70%</span> and boosting Lighthouse performance scores from <span class="text-[#F8F8F8]">30 to 50</span>.
            </p>
            <p class="text-lg font-light text-[#8c8c8c] leading-relaxed pl-3 border-l border-[#2a2a2a]">
              Successfully recovered a compromised client website following a critical WordPress vulnerability breach, executing malware removal, secure backup restoration, and system hardening.
            </p>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-xl text-[#F8F8F8] font-medium">Applause</span>
            <span class="text-sm text-[#8c8c8c] font-light tabular-nums"
              >Jul 2023 – Present</span
            >
          </div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-base text-[#8c8c8c] font-light italic"
              >QA Tester / Team Test Lead</span
            >
            <span class="text-sm text-[#8c8c8c] font-light">Freelancer · Remote</span>
          </div>
          <div class="flex flex-col gap-1.5 mt-1">
            <p class="text-lg font-light text-[#8c8c8c] leading-relaxed pl-3 border-l border-[#2a2a2a]">
              Ranked among the <span class="text-[#F8F8F8]">top 2%</span> of testers while executing functional and regression testing across web and mobile products.
            </p>
            <p class="text-lg font-light text-[#8c8c8c] leading-relaxed pl-3 border-l border-[#2a2a2a]">
              Identified, reproduced, and documented software defects with detailed reproduction steps and supporting evidence used to validate production releases.
            </p>
            <p class="text-lg font-light text-[#8c8c8c] leading-relaxed pl-3 border-l border-[#2a2a2a]">
              Selected as <span class="text-[#F8F8F8]">Team Test Lead</span> (Jun – Nov 2025), coordinating test cycles and reviewing tester submissions for completeness, accuracy, and reproducibility.
            </p>
          </div>
        </div>
      </div>

      <div
        id="tab-education"
        class="[grid-area:1/1] flex flex-col gap-10 invisible pointer-events-none"
      >
        <div class="flex flex-col gap-0.5">
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-xl text-[#F8F8F8] font-medium"
              >ITS Accademia Digitale Liguria</span
            >
            <span class="text-sm text-[#8c8c8c] font-light tabular-nums"
              >Nov 2024 – Jul 2026</span
            >
          </div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-base text-[#8c8c8c] font-light italic"
              >AR/VR Game Developer</span
            >
            <span class="text-sm text-[#8c8c8c] font-light">Final grade: 89/100</span>
          </div>
        </div>

        <div class="flex flex-col gap-0.5">
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-xl text-[#F8F8F8] font-medium"
              >IIS Majorana-Giorgi</span
            >
            <span class="text-sm text-[#8c8c8c] font-light tabular-nums"
              >2017 – 2022</span
            >
          </div>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-base text-[#8c8c8c] font-light italic"
              >Computer Science & Telecommunications</span
            >
            <span class="text-sm text-[#8c8c8c] font-light">Final grade: 94/100</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const tabs: Record<string, HTMLElement | null> = {
    work: document.getElementById("tab-work"),
    education: document.getElementById("tab-education"),
  };

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.dataset.tab as string;

      buttons.forEach((b) => {
        const isActive = b.dataset.tab === target;
        b.classList.toggle("text-[#F8F8F8]", isActive);
        b.classList.toggle("border-[#F8F8F8]", isActive);
        b.classList.toggle("text-[#8c8c8c]", !isActive);
        b.classList.toggle("border-transparent", !isActive);
      });

      Object.entries(tabs).forEach(([key, el]) => {
        if (!el) return;
        const isActive = key === target;
        el.classList.toggle("invisible", !isActive);
        el.classList.toggle("pointer-events-none", !isActive);
      });
    });
  });
</script>
